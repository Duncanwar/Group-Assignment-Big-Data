  "panels": [
    {
      "id": 1,
      "title": "Hourly regional energy (kWh)",
      "type": "timeseries",
      "description": "Raw mode: reads energy_readings directly",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time_bucket(INTERVAL '1 hour', r.event_time, 'Africa/Kigali') AS \"time\",\n       m.region AS metric,\n       sum(r.energy_kwh) AS \"Energy (kWh)\"\nFROM energy_readings r\nJOIN meters m ON m.meter_id = r.meter_id\nWHERE r.event_time >= '$start_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  AND r.event_time < '$end_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Daily network energy (kWh)",
      "type": "barchart",
      "description": "Raw mode: reads energy_readings directly",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT (r.event_time AT TIME ZONE 'Africa/Kigali')::date::text AS day,\n       sum(r.energy_kwh) AS \"Energy (kWh)\"\nFROM energy_readings r\nWHERE r.event_time >= '$start_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  AND r.event_time < '$end_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "showValue": "auto"
      }
    },
    {
      "id": 3,
      "title": "Network energy per seven-day period (kWh)",
      "type": "barchart",
      "description": "Raw mode: reads energy_readings directly",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(DATE '2026-09-01' + 7 * (((r.event_time AT TIME ZONE 'Africa/Kigali')::date - DATE '2026-09-01') / 7), 'YYYY-MM-DD') AS period_start,\n       sum(r.energy_kwh) AS \"Energy (kWh)\"\nFROM energy_readings r\nWHERE r.event_time >= '$start_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  AND r.event_time < '$end_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "showValue": "auto"
      }
    },
    {
      "id": 4,
      "title": "Daily energy for selected meter (kWh)",
      "type": "barchart",
      "description": "Raw mode: reads energy_readings directly",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT (r.event_time AT TIME ZONE 'Africa/Kigali')::date::text AS day,\n       sum(r.energy_kwh) AS \"Energy (kWh)\"\nFROM energy_readings r\nWHERE r.meter_id = $meter_id\n  AND r.event_time >= '$start_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  AND r.event_time < '$end_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "showValue": "auto"
      }
    },
    {
      "id": 5,
      "title": "Completeness by region (%)",
      "type": "barchart",
      "description": "Raw mode: reads energy_readings directly",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH reg AS (SELECT region, count(*) AS meters FROM meters GROUP BY region),\nobs AS (\n  SELECT m.region, count(*) AS observed\n  FROM energy_readings r\n  JOIN meters m ON m.meter_id = r.meter_id\n  WHERE r.event_time >= '$start_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  AND r.event_time < '$end_date'::date::timestamp AT TIME ZONE 'Africa/Kigali'\n  GROUP BY m.region)\nSELECT reg.region,\n       100.0 * obs.observed / (reg.meters * (('$end_date'::date - '$start_date'::date) * 96)) AS \"Completeness (%)\"\nFROM reg\nJOIN obs ON obs.region = reg.region\nORDER BY reg.region"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "showValue": "auto"
      }
    }
  ]
}